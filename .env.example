# --- Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bankmesh?schema=public"

# --- Temporal
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="bankmesh"

# --- Plaid (UK Open Banking via Plaid AISP/PISP)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"                      # sandbox | development | production
PLAID_WEBHOOK_SECRET=""                  # used to verify webhook signatures

# --- AES key for access_token encryption at rest (32 bytes, base64)
ACCESS_TOKEN_AES_KEY=""

# --- Insignis (MMF deposit / withdraw)
INSIGNIS_API_KEY=""
INSIGNIS_PORTFOLIO_ID=""

# --- Slack (sweep notifications)
SLACK_BOT_TOKEN=""

# --- Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
